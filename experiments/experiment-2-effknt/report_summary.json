{
 "title": "A Kahan-compensated bfloat16 AdamW writer delivers the intended update on SmolLM2-135M; its held-out loss is within \u00b10.01 of fp32 master weights at lr 1e-4 and 5e-5 and not decided at 2e-4; delivering the update helps at low learning rates and hurts at 2e-4",
 "headline": "Kahan compensation realizes between 0.9998 and 1.0001 of the intended cumulative update length at every learning rate (plain bf16 round-to-nearest: 0.130 to 0.264) and reproduces fp32 master held-out NLL within \u00b10.01 at lr 1e-4 and 5e-5 (paired mean within 0.001); at 2e-4 the comparison is not decided (90% CI -0.024 to +0.006). Delivering the intended update is worse than the plain bf16 baseline by 0.097 nats at lr 2e-4 and better by 0.017 (1e-4) and 0.123 (5e-5), so the learning-rate sign flip seen on Mamba-3 reproduces here.",
 "assessment": "signal",
 "research_question": "Build a compensated bfloat16 AdamW writer (bf16 parameters and moments, one fp32 intent path, compensation by Kahan residual, selective residual, stochastic rounding, or fp32 master copy) and test: Q1 does Kahan deliver the intended update; Q2 does Kahan reproduce fp32 master weights in held-out loss; Q3 does delivering the intended update help or hurt depending on learning rate.",
 "decision_rules": {
  "q1": "supports if at every lr kahan seed-mean cumulative length ratio >= 0.98 and |rho-1| <= 0.02 and rne length ratio < 0.9; refutes if at every lr |len(kahan)-len(rne)| < 0.05; else partial",
  "q1_verdict": "supports",
  "q2": "reproduces master if 90% CI of kahan - fp32_master inside [-0.01, 0.01] at every lr; differs if any CI entirely outside; else not decided at this power",
  "q2_verdict": "not decided at this power",
  "q3": "supports if 90% CI of rne - fp32_master < 0 at 2e-4 and > 0 at 5e-5; refutes if all three CIs exclude 0 with the same sign; else not decided at this power",
  "q3_verdict": "supports",
  "null_control": "rne minus torch.optim.AdamW(fused=False) is the noise floor; C reached 0.000396"
 },
 "methods": {
  "model": "HuggingFaceTB/SmolLM2-135M @ 93efa2f097d58c2a74874c7e644dbc9b0cee75a2, bfloat16 parameters",
  "data": "gsm8k main @ 740312add88f781978c0658806c59bc2815b9866; train rows in a seed-specific fixed order, question + newline + answer + eos, max 512 tokens, batch 1, 3000 steps",
  "held_out": "256 fixed test questions (rng(1234) permutation of the 1319 test rows), NLL per token over all 49,277 tokens, evaluated once untrained (1.9372) and once at the end of every run",
  "conditions": [
   "torch_adamw (null control)",
   "rne",
   "kahan",
   "fp32_master",
   "selective",
   "sr"
  ],
  "learning_rates": [
   0.0002,
   0.0001,
   5e-05
  ],
  "seeds": [
   0,
   1,
   2,
   3,
   4
  ],
  "n_runs": 90,
  "optimizer": "AdamW betas (0.9, 0.999), eps 1e-8, weight decay 0.01, no schedule, grad clip 32; moments bf16 in every condition, updated in torch's foreach op order so they match torch bit for bit",
  "writers": {
   "rne": "single bf16 round-to-nearest write of p + intent",
   "kahan": "bf16 residual c: t = p + i + c; p' = bf16(t); c' = bf16(t - p')",
   "selective": "as kahan but c' = 0 wherever p' != p",
   "sr": "stochastic rounding of p + i via int32 bit trick, seeded torch.Generator",
   "fp32_master": "fp32 master += i; p = bf16(master)"
  },
  "delivery_metrics": "cumulative over the run: length ratio ||sum realized|| / ||sum intended||, overshoot rho = ||r||^2 / <i, r> with i the intended and r the realized update, accumulated over all coordinates and steps (realization.py), cosine, never-moved fraction of coordinates; per family attention / MLP / embedding / norm",
  "statistics": "paired per-seed differences, Student-t 90% intervals over 5 seeds",
  "equivalence_check": "20-step run of rne against torch.optim.AdamW per seed on the real model: identical losses, bit-exact moments, min exact write agreement 0.99793 (threshold 0.997)",
  "compute": "5 on-demand 1xH100 jobs (one per seed, 18 runs each), 1.5 to 2.3 h per job; mean 0.123 s/step"
 },
